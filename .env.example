# Все ключи необязательны: без них работают Rentola, Craigslist, OpenStreetMap и простой режим ИИ.

# --- ИИ-помощник (выберите один вариант) ---
# Claude:
ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
#
# Или любой OpenAI-совместимый (OpenAI, OpenRouter, Groq, локальная Ollama):
# AI_PROVIDER=openai
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=
# AI_MODEL=qwen2.5:14b

# --- Источники жилья ---
SERPAPI_KEY=          # Google Hotels: Booking, Expedia, Agoda, Airbnb/Vrbo…  https://serpapi.com
RAPIDAPI_KEY=         # Booking.com (booking-com15)                            https://rapidapi.com
LITEAPI_KEY=          # LiteAPI, 2M+ отелей                                    https://liteapi.travel
APIFY_TOKEN=          # акторы Apify из config/sources.yaml                    https://apify.com

# --- Тонкая настройка ---
# SOURCE_TIMEOUT=45
# CACHE_TTL=1800
# MAX_DISTANCE_KM=60
# DISABLE_DEMO=1
